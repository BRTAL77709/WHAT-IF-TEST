  "subtitle_source_sha256": "22d6b0288d8475d345b9198fbf7fda4f96e6b4a32797cd9557dff6a2b9ccd338",
  "narration_cues": [
    {
      "id": 1,
      "start": 0.25,
      "end": 2.515,
      "text": "What if money actually grew on trees?"
    },
    {
      "id": 2,
      "start": 2.755,
      "end": 4.617,
      "text": "One leaf could change everything."
    },
    {
      "id": 3,
      "start": 8.25,
      "end": 9.981,
      "text": "At first, people would race"
    },
    {
      "id": 4,
      "start": 10.221,
      "end": 11.763,
      "text": "to harvest a fortune."
    },
    {
      "id": 5,
      "start": 16.25,
      "end": 17.727,
      "text": "Then more trees bloom."
    },
    {
      "id": 6,
      "start": 17.967,
      "end": 19.809,
      "text": "Soon, cash is everywhere."
    },
    {
      "id": 7,
      "start": 24.25,
      "end": 25.813,
      "text": "Everyone can spend more."
    },
    {
      "id": 8,
      "start": 26.053,
      "end": 27.82,
      "text": "But the shelves have not grown."
    },
    {
      "id": 9,
      "start": 32.25,
      "end": 34.298,
      "text": "More money cannot instantly create"
    },
    {
      "id": 10,
      "start": 34.538,
      "end": 36.625,
      "text": "more bread, homes, or workers."
    },
    {
      "id": 11,
      "start": 40.25,
      "end": 42.359,
      "text": "With the same goods and far more cash,"
    },
    {
      "id": 12,
      "start": 42.599,
      "end": 43.888,
      "text": "prices could soar."
    },
    {
      "id": 13,
      "start": 48.25,
      "end": 50.447,
      "text": "A mountain of banknotes might barely buy"
    },
    {
      "id": 14,
      "start": 50.687,
      "end": 51.912,
      "text": "a single loaf."
    },
    {
      "id": 15,
      "start": 56.25,
      "end": 58.264,
      "text": "Real wealth comes from growing food,"
    },
    {
      "id": 16,
      "start": 58.504,
      "end": 61.293,
      "text": "building homes, and delivering what people need."
    },
    {
      "id": 17,
      "start": 64.25,
      "end": 66.69800000000001,
      "text": "Even a millionaire could face an empty shop,"
    },
    {
      "id": 18,
      "start": 66.938,
      "end": 68.351,
      "text": "and go home hungry."
    },
    {
      "id": 19,
      "start": 72.25,
      "end": 73.717,
      "text": "Would you want this world?"
    },
    {
      "id": 20,
      "start": 73.957,
      "end": 75.565,
      "text": "Tell us: yes or no."
    }
  ],
